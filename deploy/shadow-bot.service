[Unit]
Description=Shadow Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadowbot
Group=shadowbot
WorkingDirectory=/opt/shadow-bot
EnvironmentFile=/etc/shadow-bot/bot.env
ExecStart=/opt/shadow-bot/.venv/bin/shadow-bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target


