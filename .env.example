# Copy to /etc/shadow-bot/bot.env on the server. Never commit real values.

# ---- Required ----

# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
# Treat this like a password: it grants full control of the bot account.
DISCORD_TOKEN=replace-me

# Async PostgreSQL URL. The postgresql+psycopg:// prefix is required.
# URL-encode reserved characters in the password: @ becomes %40, # becomes %23.
DATABASE_URL=postgresql+psycopg://shadow_bot:replace-me@192.168.1.20:5432/shadow_bot

# ---- Recommended ----

# Your Discord user ID, for emergency cross-guild support access.
# Comma-separate multiple IDs. Enable Developer Mode in Discord to copy IDs.
BOT_OWNER_IDS=123456789012345678

# While developing, set your private test server ID so slash commands register
# instantly instead of taking up to an hour to propagate globally.
# Delete this line when you want commands registered globally.
TEST_GUILD_ID=123456789012345678

# ---- Privileged intents ----
# Each must ALSO be toggled on in the Developer Portal under Bot -> Privileged
# Gateway Intents. Requesting one here that is off in the portal makes the bot
# fail to connect with PrivilegedIntentsRequired.

# Required now: member cleanup on leave/kick/ban and role-change cooldown resets.
ENABLE_MEMBERS_INTENT=true

# Not used by any current feature. Leave false until something actually reads
# message text — requesting intents you do not use complicates verification
# once the bot reaches 100 servers.
ENABLE_MESSAGE_CONTENT_INTENT=false

# ---- Optional ----

LOG_LEVEL=INFO

# Directory holding hand-edited narration files (hungrygames.md, work.md,
# crime.md, steal.md, slut.md), read once at startup. Kept outside the
# installed package so `pip install --upgrade` cannot clobber edits made
# here. Missing, empty, or containing an invalid file all fall back to the
# narration shipped with the package — a bad edit never leaves the bot mute
# or fails startup. No live reload: restart the bot to pick up an edit.
# EVENTS_DIR=/etc/shadow-bot/events
