# Never commit the real values from this file.
DISCORD_TOKEN=replace-me
DATABASE_URL=postgresql+psycopg://shadow_bot:replace-me@192.168.1.20:5432/shadow_bot

# Your Discord user ID. Multiple IDs may be separated with commas.
BOT_OWNER_IDS=123456789012345678

# Use a private test server ID while developing so slash commands update quickly.
# Remove this variable when commands should be registered globally.
TEST_GUILD_ID=123456789012345678

# Required now for member cleanup and role-change tracking.
ENABLE_MEMBERS_INTENT=true

# The current bot does not read messages, but this can remain enabled for later features.
ENABLE_MESSAGE_CONTENT_INTENT=true

LOG_LEVEL=INFO

